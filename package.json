{
  "name": "sales-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "type-check": "next typegen && tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:rls": "vitest run tests/integration",
    "test:e2e": "playwright test --grep-invert @screenshot",
    "screenshot": "playwright test --grep @screenshot",
    "test:demo-e2e": "playwright test -c playwright.demo.config.ts",
    "seed:test": "node --env-file=.env.local scripts/seed-test-users.mts",
    "admin:first": "node --env-file=.env.local scripts/create-first-admin.mts",
    "demo:dev": "npm run dev --workspace=demo",
    "demo:build": "npm run build --workspace=demo",
    "demo:type-check": "npm run type-check --workspace=demo"
  },
  "workspaces": [
    "demo"
  ],
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@google/genai": "^2.31.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
