# .env.example｜環境変数の一覧（キー名だけ。値は書かない）
# 使い方：このファイルをコピーして .env.local を作り、= の後ろに値を貼る。
# .env.local は Git に入れない（秘密情報のため）。
# 一覧と説明：docs/ の環境変数一覧

# ---- Supabase ----
# SupabaseのURL（公開可）
# 取得元：Supabase の管理画面 → 案件8のプロジェクト → Project Settings → Data API（または API）→ Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabaseの公開キー（公開可・RLSが前提）
# 取得元：Project Settings → API Keys → anon（public）または publishable キー
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabaseの管理用キー（絶対に公開しない・サーバー側のみ）
# 用途：管理者画面の処理（メンバー追加・一時パスワード再発行・状態の変更）とテスト
# 取得元：Project Settings → API Keys → service_role（secret）の「Reveal」→ コピー
# 注意：NEXT_PUBLIC_ を付けない。チャット・ログ・スクショに出さない
SUPABASE_SERVICE_ROLE_KEY=

# ---- LLM ----
# 使うLLM：claude（本番）／gemini（検証）。手動で切り替える（自動フォールバックなし）
LLM_PROVIDER=

# Gemini のモデル名（任意・文章の質の確認時だけ gemini-3.8-flash）
# 空のままなら gemini-3.5-flash-lite。使える値はこの2つだけ（それ以外はエラー）
GEMINI_MODEL=

# Claude API のキー（本番用・サーバー側のみ）
# 取得元：Anthropic Console（console.anthropic.com）→ API Keys → Create Key
ANTHROPIC_API_KEY=

# Gemini API のキー（検証用・サーバー側のみ）
# 取得元：Google AI Studio → Get API key → Create API key
GEMINI_API_KEY=

# ---- テスト用アカウント（手元の .env.local だけ。本番・Vercel には入れない）----
# 権限テスト（npm run test:rls）と画面確認（npm run screenshot）で使う
# メールは @example.com のテスト用アドレス、パスワードは各自で決める（12文字以上）
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_OPERATOR_EMAIL=
TEST_OPERATOR_PASSWORD=
TEST_OTHER_SHOP_EMAIL=
TEST_OTHER_SHOP_PASSWORD=

# ---- デプロイ（.env.local には入れない。GitHub Secrets にだけ登録する）----
# VERCEL_TOKEN：Vercel → Account Settings → Tokens → Create
# VERCEL_ORG_ID・VERCEL_PROJECT_ID：Vercel のプロジェクトをリンクしたときの .vercel/project.json（Day9 で手順を出す）
